{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentspectesting.artifact-bundle/v0.1",
  "title": "AgentSpecTesting Artifact Bundle",
  "type": "object",
  "required": [
    "schema_version",
    "bundle_id",
    "compile_run_id",
    "domain",
    "read_only",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "agentspectesting.artifact-bundle/v0.1"
    },
    "bundle_id": {
      "type": "string",
      "minLength": 1
    },
    "compile_run_id": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "source_workspace": {
      "type": "string"
    },
    "read_only": {
      "const": true
    },
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "schema_version"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "schema_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
