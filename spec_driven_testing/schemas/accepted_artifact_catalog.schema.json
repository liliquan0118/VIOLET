{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentspectesting.accepted-artifact-catalog/v0.1",
  "title": "Accepted Artifact Capability Catalog",
  "type": "object",
  "required": [
    "schema_version",
    "catalog_id",
    "domain",
    "bundle_identity",
    "artifacts",
    "capability_index",
    "catalog_fingerprint"
  ],
  "properties": {
    "schema_version": {
      "const": "agentspectesting.accepted-artifact-catalog/v0.1"
    },
    "catalog_id": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "minLength": 1},
    "bundle_identity": {
      "type": "object",
      "required": [
        "artifact_bundle_id",
        "compile_run_id",
        "bundle_schema_version"
      ],
      "properties": {
        "artifact_bundle_id": {"type": "string", "minLength": 1},
        "compile_run_id": {"type": "string", "minLength": 1},
        "bundle_schema_version": {
          "const": "agentspectesting.artifact-bundle/v0.1"
        }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/resolvedArtifact"
      }
    },
    "capability_index": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "minLength": 1}
      }
    },
    "catalog_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "resolvedArtifact": {
      "type": "object",
      "required": ["metadata", "document"],
      "properties": {
        "metadata": {
          "type": "object",
          "required": [
            "artifact_id",
            "path",
            "sha256",
            "schema_version",
            "capabilities",
            "document_fingerprint"
          ],
          "properties": {
            "artifact_id": {"type": "string", "minLength": 1},
            "path": {"type": "string", "minLength": 1},
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "schema_version": {"type": "string", "minLength": 1},
            "capabilities": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "document_fingerprint": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        },
        "document": {"type": "object"}
      },
      "additionalProperties": false
    }
  }
}
