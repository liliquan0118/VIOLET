{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentspectesting.abstract-evaluation-target/v0.1",
  "title": "Abstract Evaluation Target",
  "type": "object",
  "required": [
    "schema_version",
    "source_record_fingerprint",
    "source_branch_id",
    "source_classification",
    "target_family",
    "subject_contract",
    "activation_contract",
    "normative_assertion",
    "source_evidence",
    "abstract_evaluation_target_fingerprint"
  ],
  "properties": {
    "schema_version": {
      "const": "agentspectesting.abstract-evaluation-target/v0.1"
    },
    "source_record_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_branch_id": {"type": "string", "minLength": 1},
    "source_classification": {"type": "object"},
    "target_family": {
      "enum": [
        "argument_constraint",
        "interaction_constraint",
        "state_or_operation_constraint",
        "normative_response_constraint",
        "source_assertion"
      ]
    },
    "subject_contract": {"type": "object"},
    "activation_contract": {"type": "object"},
    "normative_assertion": {"type": "object"},
    "source_evidence": {"type": "object"},
    "abstract_evaluation_target_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
